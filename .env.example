# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Optional: override default model (must support vision)
# OPENAI_MODEL=gpt-4o

# Cost / tokens (defaults are tuned for quality vs price)
# Vision: auto (default) | low (cheapest) | high (most detail, priciest)
# OPENAI_IMAGE_DETAIL=auto
# Cap model reply length (512–8192). Default 2048 (summary + walkthrough only).
# OPENAI_MAX_OUTPUT_TOKENS=2048
# Slightly lower = shorter, steadier replies (0–1). Default 0.35
# OPENAI_TEMPERATURE=0.35
